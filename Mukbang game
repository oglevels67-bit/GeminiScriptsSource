-- Auto Eat loop
task.spawn(function()
	while true do
		task.wait(0.1)
		if autoEatEnabled then
			local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
			local character = LocalPlayer.Character
			if backpack and character then
				local tools = backpack:GetChildren()
				if #tools == 0 and not character:FindFirstChildOfClass("Tool") then
					turnOffAutoEat()
					showExplanation("⚠️ Auto Eat turned off: Your inventory is fully digested!")
				elseif #tools > 0 and not character:FindFirstChildOfClass("Tool") then
					local randomTool = tools[math.random(1, #tools)]
					if randomTool:IsA("Tool") then
						randomTool.Parent = character
						while randomTool.Parent == character and autoEatEnabled do
							local success = pcall(function()
								randomTool:Activate()
							end)
							if not success then break end
							task.wait(0.05)
						end
					end
				end
			end
		end
	end
end)

-- 1 Chomp loop
task.spawn(function()
	local lastItemName = ""
	local lastItemInstance = nil
	local lastSelectionTime = 0

	while true do
		RunService.Heartbeat:Wait()
		if chompOnceEnabled then
			local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
			local character = LocalPlayer.Character
			if backpack and character then
				local tools = backpack:GetChildren()
				if #tools == 0 and not character:FindFirstChildOfClass("Tool") then
					turnOff1Chomp()
					showExplanation("⚠️ 1 Chomp turned off: No items remaining inside backpack!")
				elseif #tools > 0 and not character:FindFirstChildOfClass("Tool") then
					local validTools = {}
					local currentTime = os.clock()

					for _, tool in ipairs(tools) do
						if tool:IsA("Tool") then
							if advancedOneChompEnabled then
								if tool ~= lastItemInstance and tool.Name ~= lastItemName then
									table.insert(validTools, tool)
								end
							else
								if #tools == 1 or tool.Name ~= lastItemName or (currentTime - lastSelectionTime) >= 1 then
									table.insert(validTools, tool)
								end
							end
						end
					end

					if #validTools == 0 then validTools = tools end

					local randomTool = validTools[math.random(1, #validTools)]
					lastItemInstance = randomTool
					lastItemName = randomTool.Name
					lastSelectionTime = currentTime

					randomTool.Parent = character
					local success = pcall(function()
						randomTool:Activate()
					end)

					local elapsed = 0
					while elapsed < chompDelay and chompOnceEnabled do
						elapsed = elapsed + RunService.Heartbeat:Wait()
					end

					if randomTool.Parent == character then
						pcall(function()
							randomTool.Parent = backpack
						end)
					end
				end
			end
		end
	end
end)

