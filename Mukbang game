local dragging = false

local function updateSliderPosition(inputPosition)
	local trackWidth = SliderTrack.AbsoluteSize.X
	local trackOriginX = SliderTrack.AbsolutePosition.X
	local relativeX = math.clamp(inputPosition.X - trackOriginX, 0, trackWidth)
	local percentage = relativeX / trackWidth

	SliderBtn.Position = UDim2.new(percentage, 0, 0.5, 0)
	SliderFill.Size = UDim2.new(percentage, 0, 1, 0)

	chompDelay = percentage * 5
	SliderLabel.Text = string.format("1 Chomp Delay: %.2fs", chompDelay)

	-- Show warning when delay is 0
	if chompDelay == 0 then
		showWarning()
	end
end

SliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		updateSliderPosition(input.Position)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSliderPosition(input.Position)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

