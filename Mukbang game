local currentInfoThread = nil
local currentWarningThread = nil

local function showBanner(banner, textLabel, text, duration)
	if banner == InfoBanner and currentInfoThread then task.cancel(currentInfoThread) end
	if banner == WarningBanner and currentWarningThread then task.cancel(currentWarningThread) end

	if textLabel then textLabel.Text = text end
	banner.Visible = true
	banner.Position = UDim2.new(0.05, 0, 1, 10)

	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.05, 0, 1, -55)
	}):Play()

	local thread = task.delay(duration or 10, function()
		local closeTween = TweenService:Create(banner, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Position = UDim2.new(0.05, 0, 1, 10)
		})
		closeTween:Play()
		closeTween.Completed:Wait()
		banner.Visible = false
	end)

	if banner == InfoBanner then currentInfoThread = thread end
	if banner == WarningBanner then currentWarningThread = thread end
end

local function showExplanation(text)
	showBanner(InfoBanner, InfoText, text, 10)
end

local function showWarning(text)
	showBanner(WarningBanner, WarningText, text or WarningText.Text, 8)
end

