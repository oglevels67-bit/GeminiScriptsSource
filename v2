----------------------------------------------------
-- GAUSSIAN HUMAN TIMING GENERATOR
----------------------------------------------------
local function randomGaussian(mean, stdDev)
    local u1 = math.max(math.random(), 1e-7)
    local u2 = math.random()
    local z0 = math.sqrt(-2.0 * math.log(u1)) * math.cos(2.0 * math.pi * u2)
    return mean + z0 * stdDev
end

local function GetHumanizedTimingOffsetSeconds(accuracy)
    local meanOffsetMs = 0
    local stdDevMs = 0

    if accuracy >= 75 then
        local factor = (100 - accuracy) / 25
        meanOffsetMs = -5 * factor
        stdDevMs = 12 + (factor * 12)
    elseif accuracy >= 50 then
        local factor = (74 - accuracy) / 24
        meanOffsetMs = -35 - (factor * 20)
        stdDevMs = 22 + (factor * 12)
    elseif accuracy >= 25 then
        local factor = (49 - accuracy) / 24
        meanOffsetMs = -75 - (factor * 30)
        stdDevMs = 30 + (factor * 15)
    else
        local factor = (24 - accuracy) / 24
        meanOffsetMs = -125 - (factor * 40)
        stdDevMs = 40 + (factor * 20)
    end

    local sampledMs = randomGaussian(meanOffsetMs, stdDevMs)
    return sampledMs / 1000
end

----------------------------------------------------
-- INPUT & MATCH HELPERS
----------------------------------------------------
local function releaseKey(key)
    if not key or not HeldKeys[key] then return end
    HeldKeys[key] = nil
    VIM:SendKeyEvent(false, key, false, game)
end

local function holdKey(key)
    if not key or HeldKeys[key] then return end
    HeldKeys[key] = true
    VIM:SendKeyEvent(true, key, false, game)
end

local function tapKey(key)
    if not key then return end
    if HeldKeys[key] then releaseKey(key) end
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.016)
    VIM:SendKeyEvent(false, key, false, game)
end

local function releaseAllKeys()
    for key, _ in pairs(HeldKeys) do
        VIM:SendKeyEvent(false, key, false, game)
    end
    HeldKeys = {}
end

local function getSortedColumns(container)
    local children = container:GetChildren()
    local t = {}
    for _, v in pairs(children) do
        if v:IsA("GuiObject") or v:IsA("Folder") or v:IsA("Configuration") then
            table.insert(t, v)
        end
    end
    table.sort(t, function(a, b)
        local numA = tonumber(a.Name)
        local numB = tonumber(b.Name)
        if numA and numB then return numA < numB end
        return a.AbsolutePosition.X < b.AbsolutePosition.X
    end)
    return t
end

local function isPlayerInActiveMatch()
    local arrowGui = nil  
    for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do  
        if obj.Name == "ArrowGui" then  
            arrowGui = obj  
            break  
        end  
    end  
      
    if not arrowGui then return false, nil, nil end

    local side = nil
    local matchesFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Matches")
    if matchesFolder then
        for _, match in pairs(matchesFolder:GetChildren()) do  
            if match:FindFirstChild("Owner") and match.Owner.Value == LocalPlayer then  
                side = (match.Owner:FindFirstChild("PlayerType") and match.Owner.PlayerType.Value == 1) and "Left" or "Right"  
                break  
            elseif match:FindFirstChild("Opponent") and match.Opponent.Value == LocalPlayer then  
                side = (match.Opponent:FindFirstChild("PlayerType") and match.Opponent.PlayerType.Value == 1) and "Left" or "Right"  
                break  
            end  
        end  
    end

    if not side then
        side = arrowGui:FindFirstChild("Right") and "Right" or "Left"
    end

    local G = arrowGui:FindFirstChild(side) or arrowGui:FindFirstChild("Right") or arrowGui:FindFirstChild("Left")
    if not G then return false, nil, nil end

    return true, G, side
end
