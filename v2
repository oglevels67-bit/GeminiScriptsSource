----------------------------------------------------
-- ENGINE CONTROL DECLARATION
----------------------------------------------------
local toggleEngineHandle = nil

local function stopAutoplay()
    playing = false
    for _, conn in pairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    Connections = {}
    releaseAllKeys()
    
    if toggleEngineHandle then
        toggleEngineHandle:Set(false, true)
    end
    
    window:Notify({
        title = "Autoplayer Halted",
        content = "Engine returned to standby mode.",
        duration = 3
    })
end

local function startAutoplay()
    if playing then return end

    local inMatch, G, side = isPlayerInActiveMatch()
    if not inMatch then  
        window:Notify({
            title = "Match Not Found",
            content = "You must be inside an active game match to run the engine.",
            duration = 4
        })
        if toggleEngineHandle then 
            toggleEngineHandle:Set(false, true) 
        end
        return  
    end  

    RunService.RenderStepped:Wait()
      
    local noteHolders = getSortedColumns(G.Notes)  
    local longHolders = getSortedColumns(G.LongNotes)  
    local receptors = getSortedColumns(G.MainArrowContainer)  
    
    local keyCount = #noteHolders
    local keyMap = KeyLayouts[keyCount] or KeyLayouts[4]
    
    playing = true  
    
    local modeName = isLegitMode and "Legit" or "Blatant"
    window:Notify({
        title = "Engine Activated",
        content = "Running (" .. modeName .. " • " .. keyCount .. "K • " .. side .. " Side)",
        duration = 4
    })

    task.spawn(function()
        while playing do
            task.wait(0.5)
            local stillInMatch = isPlayerInActiveMatch()
            if not stillInMatch and playing then
                stopAutoplay()
                break
            end
        end
    end)

    for i, holder in ipairs(noteHolders) do
        if i > #keyMap then break end
        local keyCode = keyMap[i]
        local receptor = receptors[i]
        local longContainer = longHolders[i]

        if keyCode and receptor then
            local conn = holder.ChildAdded:Connect(function(note)
                task.spawn(function()
                    if not isLegitMode then
                        while note and note.Parent and playing do
                            local success, diff = pcall(function()
                                return (receptor.AbsolutePosition - note.AbsolutePosition).Magnitude
                            end)
                            if not success or diff <= 25 then break end
                            RunService.RenderStepped:Wait()
                        end
                    else
                        local initialY = note.AbsolutePosition.Y
                        local lastY = initialY
                        local velocityY = 0
                        local targetY = receptor.AbsolutePosition.Y

                        for _ = 1, 2 do
                            RunService.RenderStepped:Wait()
                            if not note or not note.Parent then return end
                            local currY = note.AbsolutePosition.Y
                            velocityY = currY - lastY
                            lastY = currY
                        end

                        if velocityY <= 0 then velocityY = 15 end

                        local humanOffsetSec = GetHumanizedTimingOffsetSeconds(accuracyValue)

                        while note and note.Parent and playing do
                            local currY = note.AbsolutePosition.Y
                            local distPixels = targetY - currY
                            local timeToTargetSec = distPixels / (velocityY * 60)

                            if timeToTargetSec <= humanOffsetSec then
                                break
                            end
                            RunService.RenderStepped:Wait()
                        end
                    end

                    if not playing or not note or not note.Parent then return end

                    if HeldKeys[keyCode] then
                        releaseKey(keyCode)
                    end

                    local isLongNote = false
                    pcall(function()
                        local body = longContainer:FindFirstChildWhichIsA("GuiObject")
                        if body then isLongNote = true end
                    end)

                    if isLongNote then
                        holdKey(keyCode)
                        while playing do
                            local shouldBreak = false
                            pcall(function()
                                local body = longContainer:FindFirstChildWhichIsA("GuiObject")
                                if not body or body.Parent ~= longContainer then
                                    shouldBreak = true
                                else
                                    local bodyBottom = body.AbsolutePosition.Y + body.AbsoluteSize.Y
                                    if bodyBottom < receptor.AbsolutePosition.Y then
                                        shouldBreak = true
                                    end
                                end
                            end)
                            if shouldBreak then break end
                            RunService.RenderStepped:Wait()
                        end
                        releaseKey(keyCode)
                    else
                        tapKey(keyCode)
                    end
                end)
            end)
            table.insert(Connections, conn)
        end
    end
end

